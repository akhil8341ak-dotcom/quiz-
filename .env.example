# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Local MongoDB: mongodb://127.0.0.1:27017/quizcraft
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/quizcraft?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/quizcraft

# JWT Authentication
JWT_SECRET=quizcraft_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma separated)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

